{
  "name": "@sadlystudios-daemon/daemon",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SadlyStudios Panel node daemon — container lifecycle, resource limits, console, files and reverse proxy",
  "main": "dist/index.js",
  "bin": {
    "spanel-daemon": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "install:node": "tsx src/cli.ts install",
    "doctor": "tsx src/cli.ts doctor",
    "test": "tsx scripts/daemon-test.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "jose": "^5.9.6",
    "tar-fs": "^3.0.6",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.10.0",
    "@types/tar-fs": "^2.0.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
