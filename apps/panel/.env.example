# ---------------------------------------------------------------------------
# SPanel — panel configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Public URL of the panel (no trailing slash)
APP_URL=https://spanel.sadlystudios.bond
APP_NAME=SPanel

# 32+ random characters. Used for AES-256-GCM at-rest encryption and session JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_KEY=change-me-to-a-long-random-string-at-least-32-chars

# SQLite by default. For PostgreSQL/MySQL also change `provider` in prisma/schema.prisma.
#   postgresql://spanel:secret@127.0.0.1:5432/spanel
#   mysql://spanel:secret@127.0.0.1:3306/spanel
DATABASE_URL="file:./dev.db"

# Session
SESSION_COOKIE=spanel_session
SESSION_TTL_DAYS=14

# Set to true when the panel runs behind nginx/Caddy/Cloudflare
TRUST_PROXY=true

# Allow /auth/register after the first admin exists (also togglable in the admin UI)
OPEN_REGISTRATION=false

# Where uploaded logos are written (relative to the panel app directory)
UPLOAD_DIR=public/uploads
